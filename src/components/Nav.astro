---
import { site } from '../data/site';
const { current = '' } = Astro.props;
---
<nav aria-label="Main">
  <a class="brand" href="/">{site.name}</a>
  <div class="links">
    <a class="plain" href="/#expertise">Expertise</a>
    <a class="plain" href="/#packages">Packages</a>
    <a class:list={['plain', { active: current === 'blog' }]} href="/blog/">Blog</a>
    <a class="plain" href="/#process">Process</a>
    <a class="btn primary sm" href="/#contact">Book a call</a>
  </div>
</nav>
