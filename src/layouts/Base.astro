---
import '../styles.css';
import { site } from '../data/site';
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    {site.analyticsId && (
      <div id="consent" hidden role="dialog" aria-label="Cookie consent">
        <p>I use Google Analytics to understand which pages are useful. Analytics cookies are set only if you accept.</p>
        <div>
          <button type="button" class="btn primary sm" id="consent-yes">Accept</button>
          <button type="button" class="btn ghost sm" id="consent-no">Decline</button>
        </div>
      </div>
      <script is:inline define:vars={{ gaId: site.analyticsId }}>
        (function () {
          var KEY = 'analytics-consent';
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
          function load() {
            gtag('consent', 'update', { analytics_storage: 'granted' });
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(s);
            gtag('js', new Date());
            gtag('config', gaId, { anonymize_ip: true });
          }
          var saved = null;
          try { saved = localStorage.getItem(KEY); } catch (e) {}
          var box = document.getElementById('consent');
          if (saved === 'yes') { load(); }
          else if (saved !== 'no') { box.hidden = false; }
          function choose(v) {
            try { localStorage.setItem(KEY, v); } catch (e) {}
            box.hidden = true;
            if (v === 'yes') load();
          }
          document.getElementById('consent-yes').addEventListener('click', function () { choose('yes'); });
          document.getElementById('consent-no').addEventListener('click', function () { choose('no'); });
        })();
      </script>
    )}
  </body>
</html>
