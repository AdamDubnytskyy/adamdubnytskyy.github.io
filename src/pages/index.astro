---
import Base from '../layouts/Base.astro';
import { site, expertise, packages, layers, writing, steps } from '../data/site';
---
<Base>
  <div class="wrap">
    <nav aria-label="Main">
      <div class="brand">{site.name}</div>
      <div class="links">
        <a class="plain" href="#expertise">Expertise</a>
        <a class="plain" href="#packages">Packages</a>
        <a class="plain" href="#writing">Writing</a>
        <a class="plain" href="#process">Process</a>
        <a class="btn primary sm" href="#contact">Book a call</a>
      </div>
    </nav>

    <header class="hero">
      <div class="loc">KUBERNETES · AWS · LVIV, UKRAINE</div>
      <h1>I build and upgrade the cloud-native platforms teams run production on.</h1>
      <div class="t1">PLATFORM ENGINEERING • DEVOPS • SRE</div>
      <div class="t2">CLOUD • KUBERNETES • SECURITY</div>
      <div class="bar" aria-hidden="true"></div>
      <p>Fixed-scope services for Kubernetes upgrades, secure CI/CD and Infrastructure as Code on AWS.</p>
      <div class="cta">
        <a class="btn primary" href="#packages">See solution packages →</a>
        <a class="btn ghost" href="#contact">Talk to me</a>
      </div>
    </header>

    <section id="expertise">
      <div class="head">
        <div class="eyebrow">Expertise</div>
        <h2>What I do</h2>
      </div>
      <div class="grid">
        {expertise.map((e) => (
          <div class="card">
            <div class="n">{e.n}</div>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="packages">
      <div class="head">
        <div class="eyebrow">Solution packages</div>
        <h2>Fixed-scope packages</h2>
      </div>
      <div class="grid">
        {packages.map((p) => (
          <article class:list={['card', 'pkg', { featured: p.featured }]}>
            <div class="top"></div>
            <div class="body">
              <div class="tag">{p.tag}</div>
              <h3>{p.name}</h3>
              <p>{p.summary}</p>
              <div class="groups">
                {p.groups.map((g) => (
                  <div class="group">
                    {g.label && <div class="glabel">{g.label}</div>}
                    <ul>{g.points.map((pt) => <li>{pt}</li>)}</ul>
                  </div>
                ))}
              </div>
              <div class="foot">
                <span class="price">{p.price}</span>
                <a href="#contact">Request scope →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="eks-upgrade">
      <div class="head">
        <div class="eyebrow">Package 01 — in detail</div>
        <h2>EKS cluster upgrade, layer by layer</h2>
        <p class="lede">Every layer of the cluster is upgraded in a deliberate order, so nothing is left running on an unsupported version.</p>
      </div>
      <div class="layers">
        {layers.map((l) => (
          <div class="layer">
            <div class="n">{l.n}</div>
            <div class="info">
              <h3>{l.title}</h3>
              <p>{l.text}</p>
            </div>
            <div class="chips">{l.chips.map((c) => <span class="chip">{c}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="writing">
      <div class="head">
        <div class="eyebrow">Proof of work</div>
        <h2>Writing</h2>
        <p class="lede">Technical articles on the CI/CD and access patterns behind Package 02.</p>
      </div>
      <div class="writing">
        {writing.map((w) => (
          <a href={w.url} rel="noopener">
            <span class="t">{w.title}</span>
            <span class="s">{w.source} ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section id="process">
      <div class="head">
        <div class="eyebrow">Process</div>
        <h2>How an engagement runs</h2>
      </div>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <div class="n">{s.n}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <div id="contact" class="contact">
      <div class="c-left">
        <h2>Request a <span class="y">service</span></h2>
        <p>Cloud-native services, Kubernetes, CI/CD and AWS infrastructure managed with Terraform. Tell me what you need and I’ll prepare for our call.</p>
        <ul class="c-list">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFD500" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span>Lviv, Ukraine · working worldwide</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFD500" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        </ul>
        <div class="c-links">
          <a class="btn ghost sm" href={site.linkedin} rel="noopener">LinkedIn</a>
          <a class="btn ghost sm" href={site.github} rel="noopener">GitHub</a>
        </div>
      </div>

      <div class="c-right">
        <div class="c-title">Get in <span class="y">touch</span></div>
        <form id="contact-form" novalidate data-email={site.email}>
          <div class="row">
            <div class="field"><label for="cf-name">Name*</label><input id="cf-name" name="name" type="text" placeholder="Enter your name here" required autocomplete="name" /></div>
            <div class="field"><label for="cf-email">Email*</label><input id="cf-email" name="email" type="email" placeholder="Enter your email here" required autocomplete="email" /></div>
          </div>
          <div class="field"><label for="cf-msg">Describe your request</label><textarea id="cf-msg" name="message" rows="3" placeholder="Current setup, goals and timeline, so I can prepare for our call"></textarea></div>
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="btn primary send">Send request →</button>
          <div id="cf-status" class="status" role="status" aria-live="polite"></div>
          <div class="note">
            Opens a draft email to me; nothing is sent until you press Send.
            <a id="cf-gmail" href="#">Open in Gmail instead</a>
            {site.booking && <> · <a href={site.booking} rel="noopener">Book a 30-minute call</a></>}
          </div>
        </form>
      </div>
    </div>

    <footer>
      <span>© {new Date().getFullYear()} {site.name} · Based in Lviv, Ukraine · Working worldwide</span>
      <span class="caps">CLOUD • KUBERNETES • SECURITY</span>
    </footer>
  </div>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');
  const gmail = document.getElementById('cf-gmail');

  function draft() {
    if (!form || !status) return null;
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const message = String(data.get('message') || '').trim();
    if (!name || !/^\S+@\S+\.\S+$/.test(email)) {
      status.textContent = 'Please enter your name and a valid email.';
      return null;
    }
    status.textContent = '';
    return {
      to: form.dataset.email || '',
      subject: `Service request from ${name}`,
      body: `${message}\n\n— ${name} (${email})`,
    };
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = draft();
    if (!d || !status) return;
    window.location.href = `mailto:${d.to}?subject=${encodeURIComponent(d.subject)}&body=${encodeURIComponent(d.body)}`;
    status.textContent = 'Opening your email app. Press Send in the draft to deliver it.';
  });

  gmail?.addEventListener('click', (e) => {
    e.preventDefault();
    const d = draft();
    if (!d) return;
    const url = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(d.to)}&su=${encodeURIComponent(d.subject)}&body=${encodeURIComponent(d.body)}`;
    window.open(url, '_blank', 'noopener');
  });
</script>
