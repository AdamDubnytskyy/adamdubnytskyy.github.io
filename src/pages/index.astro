---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { site, expertise, packages, layers, steps, certifications } from '../data/site';
const latest = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 3);
---
<Base>
  <div class="wrap">
    <Nav />

    <header class="hero">
      <div class="loc">KUBERNETES · AWS · LVIV, UKRAINE</div>
      <h1>I build and upgrade the cloud-native platforms teams run production on.</h1>
      <div class="t1">PLATFORM ENGINEERING • DEVOPS • SRE</div>
      <div class="t2">CLOUD • KUBERNETES • SECURITY</div>
      <div class="bar" aria-hidden="true"></div>
      <p>Fixed-scope services for Kubernetes upgrades, secure CI/CD and Infrastructure as Code on AWS.</p>
      <div class="cta">
        <a class="btn primary" href="#packages">See solution packages →</a>
        <a class="btn ghost" href="#contact">Talk to me</a>
      </div>
    </header>

    <section id="expertise">
      <div class="head">
        <div class="eyebrow">Expertise</div>
        <h2>What I do</h2>
      </div>
      <div class="grid">
        {expertise.map((e) => (
          <div class="card">
            <div class="n">{e.n}</div>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="packages">
      <div class="head">
        <div class="eyebrow">Solution packages</div>
        <h2>Fixed-scope packages</h2>
      </div>
      <div class="grid">
        {packages.map((p) => (
          <article class:list={['card', 'pkg', { featured: p.featured }]}>
            <div class="top"></div>
            <div class="body">
              <div class="tag">{p.tag}</div>
              <h3>{p.name}</h3>
              <p>{p.summary}</p>
              {p.options && (
                <div class="options">
                  {p.options.map((o) => (
                    <div class={o.highlight ? 'note hl' : 'note'}>
                      <div class="nl">{o.label}</div>
                      <div class="nt">{o.title}</div>
                      <p>{o.text}</p>
                    </div>
                  ))}
                </div>
              )}
              <div class="groups">
                {p.groups.map((g) => (
                  <div class="group">
                    {g.label && <div class="glabel">{g.label}</div>}
                    <ul>{g.points.map((pt) => <li>{pt}</li>)}</ul>
                  </div>
                ))}
              </div>
              <div class="foot">
                <span class="price">{p.price}</span>
                <a href="#contact">Request scope →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="eks-upgrade">
      <div class="head">
        <div class="eyebrow">Package 01 — in detail</div>
        <h2>EKS cluster upgrade, layer by layer</h2>
        <p class="lede">Every layer of the cluster is upgraded in a deliberate order, so nothing is left running on an unsupported version.</p>
      </div>
      <div class="layers">
        {layers.map((l) => (
          <div class="layer">
            <div class="n">{l.n}</div>
            <div class="info">
              <h3>{l.title}</h3>
              <p>{l.text}</p>
            </div>
            <div class="chips">{l.chips.map((c) => <span class="chip">{c}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="writing">
      <div class="head">
        <div class="eyebrow">Proof of work</div>
        <h2>Latest writing</h2>
        <p class="lede">Technical articles on CI/CD, access and platform work on AWS.</p>
        <a class="more" href="/blog/">All posts →</a>
      </div>
      <PostList posts={latest} />
    </section>

    <section id="process">
      <div class="head">
        <div class="eyebrow">Process</div>
        <h2>How an engagement runs</h2>
      </div>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <div class="n">{s.n}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="certs">
      <div class="certs-text">
        <h2><span class="y">Certifications</span> &amp; credentials</h2>
        <p>Verified credentials, each linked to its Credly page.</p>
      </div>
      <div class="certs-grid">
        {certifications.map((c) => (
          <a href={c.url} target="_blank" rel="noopener">
            {c.image ? (
              <img class="badge" src={c.image} alt={`${c.name} badge`} width="112" height="112" loading="lazy" />
            ) : (
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M32 4 55 17.5v29L32 60 9 46.5v-29z" stroke="#A3A3A3" stroke-width="2"/><path d="m22 33 7 7 13-14" stroke="#FFD500" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            <span class="cn">{c.name}</span>
            <span class="ci">{c.issuer}</span>
          </a>
        ))}
      </div>
    </div>

    <div id="contact" class="contact">
      <div class="c-left">
        <h2>Request a <span class="y">service</span></h2>
        <p>Cloud-native services, Kubernetes, CI/CD and AWS infrastructure managed with Terraform. Tell me what you need and I’ll prepare for our call.</p>
        <ul class="c-list">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFD500" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span>Lviv, Ukraine · working worldwide</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFD500" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        </ul>
        <div class="c-links">
          <a class="btn ghost sm" href={site.linkedin} rel="noopener">LinkedIn</a>
          <a class="btn ghost sm" href={site.github} rel="noopener">GitHub</a>
        </div>
      </div>

      <div class="c-right">
        <div class="c-title">Get in <span class="y">touch</span></div>
        <form id="contact-form" novalidate data-email={site.email}>
          <div class="row">
            <div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" type="text" placeholder="Enter your name here" autocomplete="name" /></div>
            <div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" placeholder="Enter your email here" autocomplete="email" /></div>
          </div>
          <div class="field"><label for="cf-msg">Describe your request</label><textarea id="cf-msg" name="message" rows="3" placeholder="Current setup, goals and timeline, so I can prepare for our call"></textarea></div>
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="btn primary send">Send request →</button>
          <div id="cf-status" class="status" role="status" aria-live="polite"></div>
          <div class="note">
            Opens a draft email to me; nothing is sent until you press Send.
            {site.booking && <> · <a href={site.booking} rel="noopener">Book a 30-minute call</a></>}
          </div>
        </form>
      </div>
    </div>

    <Footer />
  </div>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');

  function draft() {
    if (!form) return null;
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const message = String(data.get('message') || '').trim();
    const sig = [name, email && `(${email})`].filter(Boolean).join(' ');
    return {
      to: form.dataset.email || '',
      subject: name ? `Service request from ${name}` : 'Service request',
      body: sig ? `${message}\n\n— ${sig}` : message,
    };
  }

  function openMailto(d: { to: string; subject: string; body: string }) {
    window.location.href = `mailto:${d.to}?subject=${encodeURIComponent(d.subject)}&body=${encodeURIComponent(d.body)}`;
    if (status) status.textContent = 'Opening your email app. Press Send in the draft to deliver it.';
    setTimeout(() => {
      if (status && document.hasFocus()) {
        status.textContent = `Nothing opened? Email ${d.to} directly.`;
      }
    }, 2000);
  }

  function openGmail(d: { to: string; subject: string; body: string }) {
    const url = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(d.to)}&su=${encodeURIComponent(d.subject)}&body=${encodeURIComponent(d.body)}`;
    window.open(url, '_blank', 'noopener');
    if (status) status.textContent = 'Opened Gmail in a new tab. Press Send there to deliver it.';
  }

  // Phones and tablets have an email app; on desktop most visitors use webmail.
  const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = draft();
    if (!d) return;
    if (isTouch) openMailto(d);
    else openGmail(d);
  });

</script>
